<% content_for(:title) { "Ayush Lahiri | Games" } %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    body {
        background-color: #f0f0f0;
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
    }

    /* --- BACK BUTTON --- */
    .games-back-btn {
        position: fixed;
        top: 28px;
        left: 28px;
        z-index: 1001;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        text-decoration: none;
        color: #333;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .games-back-btn:hover {
        background: rgba(128, 0, 128, 0.1);
        color: purple;
        transform: translateX(-3px);
    }

    /* --- PAGE TITLE --- */
    .games-hero {
        text-align: center;
        padding: 120px 20px 40px 20px;
    }

    .games-hero h1 {
        font-family: 'Segoe UI', sans-serif;
        font-size: 2.8rem;
        font-weight: 800;
        color: #1a1a1a;
        margin-bottom: 12px;
        letter-spacing: -1px;
    }

    .games-hero p {
        font-size: 1.15rem;
        color: #666;
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* --- GAMES GRID --- */
    .games-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 28px;
        justify-content: center;
        padding: 20px 40px 80px 40px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .game-card {
        flex: 1 1 calc(33.333% - 28px);
        min-width: 280px;
        max-width: 340px;
        padding: 32px 28px;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.7);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
        text-align: center;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

    .game-card:hover {
        transform: translateY(-8px) scale(1.02);
        background: rgba(255, 255, 255, 0.65);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
    }

    .game-card-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }

    .game-card h3 {
        font-family: 'Segoe UI', sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: #222;
        margin: 0;
    }

    .game-card p {
        font-size: 0.9rem;
        color: #777;
        line-height: 1.5;
        margin: 0;
    }

    .game-card .play-tag {
        padding: 6px 24px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: 2px solid #333;
        color: #333;
        background: transparent;
        transition: all 0.3s ease;
    }

    .game-card:hover .play-tag {
        background: #333;
        color: white;
    }

    /* --- GAME MODAL OVERLAY --- */
    .game-modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(8px);
        z-index: 2000;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        overflow-y: auto;
        padding: 20px;
    }

    .game-modal-overlay.active {
        display: flex;
    }

    .game-modal-close {
        position: fixed;
        top: 20px;
        right: 24px;
        z-index: 2001;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.25);
        color: white;
        font-size: 1.4rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .game-modal-close:hover {
        background: rgba(255,255,255,0.3);
        transform: scale(1.1);
    }

    .game-modal-content {
        width: 100%;
        max-width: 700px;
        margin-top: 60px;
        display: none;
    }

    .game-modal-content.active {
        display: block;
    }

    /* --- MOBILE --- */
    @media (max-width: 768px) {
        .games-back-btn {
            top: 16px;
            left: 16px;
            padding: 8px 16px;
            font-size: 0.85rem;
        }

        .games-hero {
            padding: 90px 16px 30px 16px;
        }

        .games-hero h1 {
            font-size: 2rem;
        }

        .games-hero p {
            font-size: 1rem;
        }

        .games-grid {
            padding: 10px 16px 60px 16px;
            gap: 18px;
        }

        .game-card {
            flex: 1 1 100%;
            min-width: 0;
            max-width: 100%;
            padding: 24px 20px;
        }

        .game-modal-content {
            margin-top: 50px;
            max-width: 100%;
        }

        .game-modal-close {
            top: 12px;
            right: 12px;
        }
    }
</style>

<!-- Back to Portfolio Button -->
<a href="/" class="games-back-btn">
    <i class="fa-solid fa-arrow-left"></i>
    Portfolio
</a>

<!-- Hero Section -->
<div class="games-hero">
    <h1>Play a Game</h1>
    <p>Take a break and enjoy some mini-games built with pure HTML, CSS, and JavaScript.</p>
</div>

<!-- Game Cards Grid -->
<div class="games-grid">
    <div class="game-card" onclick="openGame('tictactoe')">
        <div class="game-card-icon" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">
            <i class="fa-solid fa-xmarks-lines"></i>
        </div>
        <h3>Tic-Tac-Toe</h3>
        <p>Classic X vs O. Challenge the AI and see if you can win.</p>
        <span class="play-tag">Play</span>
    </div>

    <div class="game-card" onclick="openGame('tetris')">
        <div class="game-card-icon" style="background: linear-gradient(135deg, #3498db, #2980b9);">
            <i class="fa-solid fa-cubes"></i>
        </div>
        <h3>Tetris</h3>
        <p>Stack falling blocks and clear lines. How long can you survive?</p>
        <span class="play-tag">Play</span>
    </div>

    <div class="game-card" onclick="openGame('pokemon')">
        <div class="game-card-icon" style="background: linear-gradient(135deg, #f39c12, #e67e22);">
            <i class="fa-solid fa-question"></i>
        </div>
        <h3>Guess the Pokemon</h3>
        <p>A silhouette appears. Can you name that Pokemon?</p>
        <span class="play-tag">Play</span>
    </div>

    <div class="game-card" onclick="openGame('dino')">
        <div class="game-card-icon" style="background: linear-gradient(135deg, #555, #333);">
            <i class="fa-solid fa-dragon"></i>
        </div>
        <h3>Chrome Dino</h3>
        <p>Jump over obstacles in this endless runner tribute.</p>
        <span class="play-tag">Play</span>
    </div>

    <div class="game-card" onclick="openGame('snake')">
        <div class="game-card-icon" style="background: linear-gradient(135deg, #27ae60, #1e8449);">
            <i class="fa-solid fa-worm"></i>
        </div>
        <h3>Snake</h3>
        <p>Guide the snake, eat food, and grow. Don't crash!</p>
        <span class="play-tag">Play</span>
    </div>
</div>

<!-- Game Modal Overlay -->
<div class="game-modal-overlay" id="gameModal">
    <button class="game-modal-close" onclick="closeGame()" aria-label="Close game">
        <i class="fa-solid fa-xmark"></i>
    </button>

    <div class="game-modal-content" id="game-tictactoe">
        <%= render 'portfolio/games/tictactoe' %>
    </div>
    <div class="game-modal-content" id="game-tetris">
        <%= render 'portfolio/games/tetris' %>
    </div>
    <div class="game-modal-content" id="game-pokemon">
        <%= render 'portfolio/games/pokemon' %>
    </div>
    <div class="game-modal-content" id="game-dino">
        <%= render 'portfolio/games/dino' %>
    </div>
    <div class="game-modal-content" id="game-snake">
        <%= render 'portfolio/games/snake' %>
    </div>
</div>

<script>
    let currentGame = null;

    function openGame(gameId) {
        const modal = document.getElementById('gameModal');
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';

        // Show the correct game content
        const gameContent = document.getElementById('game-' + gameId);
        if (gameContent) {
            gameContent.classList.add('active');
        }
        currentGame = gameId;

        // Dispatch a custom event so games can initialize
        window.dispatchEvent(new CustomEvent('game-opened', { detail: { game: gameId } }));
    }

    function closeGame() {
        const modal = document.getElementById('gameModal');
        modal.classList.remove('active');
        document.body.style.overflow = '';

        // Hide all game contents
        document.querySelectorAll('.game-modal-content').forEach(el => el.classList.remove('active'));

        // Dispatch close event so games can clean up
        if (currentGame) {
            window.dispatchEvent(new CustomEvent('game-closed', { detail: { game: currentGame } }));
        }
        currentGame = null;
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && currentGame) closeGame();
    });
</script>
