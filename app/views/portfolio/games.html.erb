<% content_for(:title) { "Ayush Lahiri | Games" } %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    body {
        background-color: #e8e4f0;
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
    }

    /* --- BACK BUTTON (Clay Pill) --- */
    .games-back-btn {
        position: fixed;
        top: 28px;
        left: 28px;
        z-index: 1001;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 26px;
        border-radius: 50px;
        background: #e8e4f0;
        border: none;
        box-shadow:
            8px 8px 16px rgba(0, 0, 0, 0.12),
            -6px -6px 14px rgba(255, 255, 255, 0.7),
            inset 2px 2px 4px rgba(255, 255, 255, 0.6),
            inset -1px -1px 3px rgba(0, 0, 0, 0.06);
        text-decoration: none;
        color: #4a4060;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .games-back-btn:hover {
        color: #7c3aed;
        transform: translateX(-3px);
        box-shadow:
            10px 10px 20px rgba(0, 0, 0, 0.14),
            -8px -8px 18px rgba(255, 255, 255, 0.8),
            inset 2px 2px 5px rgba(255, 255, 255, 0.7),
            inset -1px -1px 3px rgba(0, 0, 0, 0.08);
    }

    /* --- PAGE TITLE --- */
    .games-hero {
        text-align: center;
        padding: 120px 20px 40px 20px;
    }

    .games-hero h1 {
        font-family: 'Segoe UI', sans-serif;
        font-size: 2.8rem;
        font-weight: 800;
        color: #2d2248;
        margin-bottom: 12px;
        letter-spacing: -1px;
        text-shadow: 1px 1px 0 rgba(255,255,255,0.5);
    }

    .games-hero p {
        font-size: 1.15rem;
        color: #6b5f80;
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* --- GAMES GRID --- */
    .games-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        justify-content: center;
        padding: 20px 40px 80px 40px;
        max-width: 1100px;
        margin: 0 auto;
    }

    /* --- CLAYMORPHISM CARD --- */
    .game-card {
        flex: 1 1 calc(33.333% - 32px);
        min-width: 280px;
        max-width: 340px;
        padding: 36px 28px;
        border-radius: 32px;
        border: none;
        text-align: center;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    /* Per-card clay colors */
    .game-card[data-game="tictactoe"] {
        background: #f8d7d7;
        box-shadow:
            10px 10px 20px rgba(180, 80, 80, 0.18),
            -8px -8px 18px rgba(255, 255, 255, 0.65),
            inset 3px 3px 6px rgba(255, 255, 255, 0.7),
            inset -2px -2px 5px rgba(180, 80, 80, 0.12);
    }

    .game-card[data-game="tetris"] {
        background: #d0e4f7;
        box-shadow:
            10px 10px 20px rgba(60, 120, 180, 0.18),
            -8px -8px 18px rgba(255, 255, 255, 0.65),
            inset 3px 3px 6px rgba(255, 255, 255, 0.7),
            inset -2px -2px 5px rgba(60, 120, 180, 0.12);
    }

    .game-card[data-game="pokemon"] {
        background: #fce8c8;
        box-shadow:
            10px 10px 20px rgba(200, 140, 50, 0.18),
            -8px -8px 18px rgba(255, 255, 255, 0.65),
            inset 3px 3px 6px rgba(255, 255, 255, 0.7),
            inset -2px -2px 5px rgba(200, 140, 50, 0.12);
    }

    .game-card[data-game="dino"] {
        background: #ddd8e4;
        box-shadow:
            10px 10px 20px rgba(90, 80, 110, 0.18),
            -8px -8px 18px rgba(255, 255, 255, 0.65),
            inset 3px 3px 6px rgba(255, 255, 255, 0.7),
            inset -2px -2px 5px rgba(90, 80, 110, 0.12);
    }

    .game-card[data-game="snake"] {
        background: #ceecd8;
        box-shadow:
            10px 10px 20px rgba(50, 140, 80, 0.18),
            -8px -8px 18px rgba(255, 255, 255, 0.65),
            inset 3px 3px 6px rgba(255, 255, 255, 0.7),
            inset -2px -2px 5px rgba(50, 140, 80, 0.12);
    }

    .game-card:hover {
        transform: translateY(-8px) scale(1.03);
    }

    .game-card[data-game="tictactoe"]:hover {
        box-shadow:
            14px 14px 28px rgba(180, 80, 80, 0.22),
            -10px -10px 22px rgba(255, 255, 255, 0.75),
            inset 4px 4px 8px rgba(255, 255, 255, 0.8),
            inset -3px -3px 6px rgba(180, 80, 80, 0.15);
    }
    .game-card[data-game="tetris"]:hover {
        box-shadow:
            14px 14px 28px rgba(60, 120, 180, 0.22),
            -10px -10px 22px rgba(255, 255, 255, 0.75),
            inset 4px 4px 8px rgba(255, 255, 255, 0.8),
            inset -3px -3px 6px rgba(60, 120, 180, 0.15);
    }
    .game-card[data-game="pokemon"]:hover {
        box-shadow:
            14px 14px 28px rgba(200, 140, 50, 0.22),
            -10px -10px 22px rgba(255, 255, 255, 0.75),
            inset 4px 4px 8px rgba(255, 255, 255, 0.8),
            inset -3px -3px 6px rgba(200, 140, 50, 0.15);
    }
    .game-card[data-game="dino"]:hover {
        box-shadow:
            14px 14px 28px rgba(90, 80, 110, 0.22),
            -10px -10px 22px rgba(255, 255, 255, 0.75),
            inset 4px 4px 8px rgba(255, 255, 255, 0.8),
            inset -3px -3px 6px rgba(90, 80, 110, 0.15);
    }
    .game-card[data-game="snake"]:hover {
        box-shadow:
            14px 14px 28px rgba(50, 140, 80, 0.22),
            -10px -10px 22px rgba(255, 255, 255, 0.75),
            inset 4px 4px 8px rgba(255, 255, 255, 0.8),
            inset -3px -3px 6px rgba(50, 140, 80, 0.15);
    }

    /* --- CLAY ICON BUBBLE --- */
    .game-card-icon {
        width: 76px;
        height: 76px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        border: none;
    }

    .game-card[data-game="tictactoe"] .game-card-icon {
        background: #e05a5a;
        box-shadow:
            6px 6px 14px rgba(180, 50, 50, 0.3),
            -4px -4px 10px rgba(255, 140, 140, 0.35),
            inset 2px 2px 4px rgba(255, 200, 200, 0.5),
            inset -2px -2px 4px rgba(140, 30, 30, 0.2);
    }

    .game-card[data-game="tetris"] .game-card-icon {
        background: #4a9fd8;
        box-shadow:
            6px 6px 14px rgba(40, 100, 170, 0.3),
            -4px -4px 10px rgba(130, 190, 255, 0.35),
            inset 2px 2px 4px rgba(180, 220, 255, 0.5),
            inset -2px -2px 4px rgba(30, 70, 130, 0.2);
    }

    .game-card[data-game="pokemon"] .game-card-icon {
        background: #e8a830;
        box-shadow:
            6px 6px 14px rgba(190, 130, 20, 0.3),
            -4px -4px 10px rgba(255, 210, 120, 0.35),
            inset 2px 2px 4px rgba(255, 230, 170, 0.5),
            inset -2px -2px 4px rgba(150, 100, 10, 0.2);
    }

    .game-card[data-game="dino"] .game-card-icon {
        background: #6b5f80;
        box-shadow:
            6px 6px 14px rgba(60, 50, 80, 0.3),
            -4px -4px 10px rgba(160, 150, 180, 0.35),
            inset 2px 2px 4px rgba(200, 190, 220, 0.5),
            inset -2px -2px 4px rgba(40, 30, 60, 0.2);
    }

    .game-card[data-game="snake"] .game-card-icon {
        background: #3daa60;
        box-shadow:
            6px 6px 14px rgba(30, 120, 60, 0.3),
            -4px -4px 10px rgba(120, 220, 150, 0.35),
            inset 2px 2px 4px rgba(160, 240, 190, 0.5),
            inset -2px -2px 4px rgba(20, 90, 40, 0.2);
    }

    .game-card h3 {
        font-family: 'Segoe UI', sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: #2d2248;
        margin: 0;
    }

    .game-card p {
        font-size: 0.9rem;
        color: #6b5f80;
        line-height: 1.5;
        margin: 0;
    }

    /* --- CLAY PLAY BUTTON --- */
    .game-card .play-tag {
        padding: 8px 28px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        color: #4a4060;
        background: rgba(255, 255, 255, 0.5);
        box-shadow:
            4px 4px 10px rgba(0, 0, 0, 0.08),
            -3px -3px 8px rgba(255, 255, 255, 0.6),
            inset 1px 1px 3px rgba(255, 255, 255, 0.7),
            inset -1px -1px 2px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

    .game-card:hover .play-tag {
        color: #2d2248;
        background: rgba(255, 255, 255, 0.7);
        box-shadow:
            6px 6px 14px rgba(0, 0, 0, 0.1),
            -4px -4px 10px rgba(255, 255, 255, 0.8),
            inset 2px 2px 4px rgba(255, 255, 255, 0.8),
            inset -1px -1px 3px rgba(0, 0, 0, 0.06);
    }

    /* --- GAME MODAL OVERLAY --- */
    .game-modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(30, 22, 50, 0.9);
        backdrop-filter: blur(10px);
        z-index: 2000;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        overflow-y: auto;
        padding: 20px;
    }

    .game-modal-overlay.active {
        display: flex;
    }

    .game-modal-close {
        position: fixed;
        top: 20px;
        right: 24px;
        z-index: 2001;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #e8e4f0;
        border: none;
        color: #4a4060;
        font-size: 1.3rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        box-shadow:
            5px 5px 12px rgba(0, 0, 0, 0.2),
            -4px -4px 10px rgba(255, 255, 255, 0.15),
            inset 2px 2px 4px rgba(255, 255, 255, 0.6),
            inset -1px -1px 3px rgba(0, 0, 0, 0.1);
    }

    .game-modal-close:hover {
        transform: scale(1.1);
        color: #7c3aed;
        box-shadow:
            7px 7px 16px rgba(0, 0, 0, 0.25),
            -5px -5px 12px rgba(255, 255, 255, 0.2),
            inset 3px 3px 5px rgba(255, 255, 255, 0.7),
            inset -2px -2px 4px rgba(0, 0, 0, 0.12);
    }

    .game-modal-content {
        width: 100%;
        max-width: 700px;
        margin-top: 60px;
        display: none;
    }

    .game-modal-content.active {
        display: block;
    }

    /* --- MOBILE --- */
    @media (max-width: 768px) {
        .games-back-btn {
            top: 16px;
            left: 16px;
            padding: 10px 18px;
            font-size: 0.85rem;
        }

        .games-hero {
            padding: 90px 16px 30px 16px;
        }

        .games-hero h1 {
            font-size: 2rem;
        }

        .games-hero p {
            font-size: 1rem;
        }

        .games-grid {
            padding: 10px 16px 60px 16px;
            gap: 22px;
        }

        .game-card {
            flex: 1 1 100%;
            min-width: 0;
            max-width: 100%;
            padding: 28px 22px;
        }

        .game-modal-content {
            margin-top: 50px;
            max-width: 100%;
        }

        .game-modal-close {
            top: 12px;
            right: 12px;
        }
    }
</style>

<!-- Back to Portfolio Button -->
<a href="/" class="games-back-btn">
    <i class="fa-solid fa-arrow-left"></i>
    Portfolio
</a>

<!-- Hero Section -->
<div class="games-hero">
    <h1>Play a Game</h1>
    <p>Take a break and enjoy some mini-games built with pure HTML, CSS, and JavaScript.</p>
</div>

<!-- Game Cards Grid -->
<div class="games-grid">
    <div class="game-card" data-game="tictactoe" onclick="openGame('tictactoe')">
        <div class="game-card-icon">
            <i class="fa-solid fa-xmarks-lines"></i>
        </div>
        <h3>Tic-Tac-Toe</h3>
        <p>Classic X vs O. Challenge the AI and see if you can win.</p>
        <span class="play-tag">Play</span>
    </div>

    <div class="game-card" data-game="tetris" onclick="openGame('tetris')">
        <div class="game-card-icon">
            <i class="fa-solid fa-cubes"></i>
        </div>
        <h3>Tetris</h3>
        <p>Stack falling blocks and clear lines. How long can you survive?</p>
        <span class="play-tag">Play</span>
    </div>

    <div class="game-card" data-game="pokemon" onclick="openGame('pokemon')">
        <div class="game-card-icon">
            <i class="fa-solid fa-question"></i>
        </div>
        <h3>Guess the Pokemon</h3>
        <p>A silhouette appears. Can you name that Pokemon?</p>
        <span class="play-tag">Play</span>
    </div>

    <div class="game-card" data-game="dino" onclick="openGame('dino')">
        <div class="game-card-icon">
            <i class="fa-solid fa-dragon"></i>
        </div>
        <h3>Chrome Dino</h3>
        <p>Jump over obstacles in this endless runner tribute.</p>
        <span class="play-tag">Play</span>
    </div>

    <div class="game-card" data-game="snake" onclick="openGame('snake')">
        <div class="game-card-icon">
            <i class="fa-solid fa-worm"></i>
        </div>
        <h3>Snake</h3>
        <p>Guide the snake, eat food, and grow. Don't crash!</p>
        <span class="play-tag">Play</span>
    </div>
</div>

<!-- Game Modal Overlay -->
<div class="game-modal-overlay" id="gameModal">
    <button class="game-modal-close" onclick="closeGame()" aria-label="Close game">
        <i class="fa-solid fa-xmark"></i>
    </button>

    <div class="game-modal-content" id="game-tictactoe">
        <%= render 'portfolio/games/tictactoe' %>
    </div>
    <div class="game-modal-content" id="game-tetris">
        <%= render 'portfolio/games/tetris' %>
    </div>
    <div class="game-modal-content" id="game-pokemon">
        <%= render 'portfolio/games/pokemon' %>
    </div>
    <div class="game-modal-content" id="game-dino">
        <%= render 'portfolio/games/dino' %>
    </div>
    <div class="game-modal-content" id="game-snake">
        <%= render 'portfolio/games/snake' %>
    </div>
</div>

<script>
    let currentGame = null;

    function openGame(gameId) {
        const modal = document.getElementById('gameModal');
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';

        // Show the correct game content
        const gameContent = document.getElementById('game-' + gameId);
        if (gameContent) {
            gameContent.classList.add('active');
        }
        currentGame = gameId;

        // Dispatch a custom event so games can initialize
        window.dispatchEvent(new CustomEvent('game-opened', { detail: { game: gameId } }));
    }

    function closeGame() {
        const modal = document.getElementById('gameModal');
        modal.classList.remove('active');
        document.body.style.overflow = '';

        // Hide all game contents
        document.querySelectorAll('.game-modal-content').forEach(el => el.classList.remove('active'));

        // Dispatch close event so games can clean up
        if (currentGame) {
            window.dispatchEvent(new CustomEvent('game-closed', { detail: { game: currentGame } }));
        }
        currentGame = null;
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && currentGame) closeGame();
    });
</script>
