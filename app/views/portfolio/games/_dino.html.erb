<style>
    .dino-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px;
        font-family: 'Segoe UI', sans-serif;
    }

    .dino-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: white;
        margin-bottom: 8px;
    }

    .dino-info {
        color: #aaa;
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .dino-info span { color: white; }

    .dino-canvas-wrap {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.15);
        box-shadow: 0 0 40px rgba(100,100,100,0.1);
        width: 100%;
        max-width: 600px;
    }

    #dino-canvas {
        display: block;
        width: 100%;
        background: #f7f7f7;
    }

    .dino-overlay {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        gap: 12px;
        transition: opacity 0.3s ease;
    }

    .dino-overlay.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .dino-overlay h2 {
        font-size: 1.5rem;
        font-weight: 800;
    }

    .dino-overlay p {
        color: #ccc;
        font-size: 0.95rem;
    }

    .dino-start-btn {
        padding: 12px 36px;
        border-radius: 50px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .dino-start-btn:hover {
        background: rgba(255,255,255,0.3);
    }

    .dino-tap-hint {
        display: none;
        color: #888;
        font-size: 0.85rem;
        margin-top: 10px;
    }

    @media (max-width: 768px) {
        .dino-tap-hint { display: block; }
    }
</style>

<div class="dino-container">
    <div class="dino-title">Chrome Dino</div>
    <div class="dino-info">
        Score: <span id="dino-score">0</span> &nbsp;|&nbsp;
        Best: <span id="dino-best">0</span>
    </div>

    <div class="dino-canvas-wrap" id="dino-canvas-wrap">
        <canvas id="dino-canvas" width="600" height="180"></canvas>
        <div class="dino-overlay" id="dino-overlay">
            <h2 id="dino-overlay-text">Chrome Dino</h2>
            <p>Press Space or Tap to jump</p>
            <button class="dino-start-btn" onclick="dinoStart()">Play</button>
        </div>
    </div>
    <div class="dino-tap-hint">Tap the game area to jump</div>
</div>

<script>
(function() {
    const canvas = document.getElementById('dino-canvas');
    const ctx = canvas.getContext('2d');
    let W, H, ground, dino, obstacles, score, bestScore = 0, speed, gameRunning, animId, frameCount;

    function resize() {
        const wrap = document.getElementById('dino-canvas-wrap');
        W = canvas.width = Math.min(600, wrap.clientWidth);
        H = canvas.height = 180;
        ground = H - 30;
    }

    function initDino() {
        return { x: 50, y: ground - 40, w: 30, h: 40, vy: 0, jumping: false };
    }

    function spawnObstacle() {
        const h = 20 + Math.random() * 25;
        const w = 12 + Math.random() * 14;
        return { x: W + Math.random() * 100, y: ground - h, w: w, h: h };
    }

    function start() {
        resize();
        dino = initDino();
        obstacles = [spawnObstacle()];
        score = 0;
        speed = 4;
        gameRunning = true;
        frameCount = 0;
        document.getElementById('dino-overlay').classList.add('hidden');
        document.getElementById('dino-score').textContent = 0;
        cancelAnimationFrame(animId);
        loop();
    }

    function jump() {
        if (!gameRunning) return;
        if (!dino.jumping) {
            dino.vy = -10;
            dino.jumping = true;
        }
    }

    function loop() {
        if (!gameRunning) return;
        ctx.clearRect(0, 0, W, H);

        // Ground
        ctx.fillStyle = '#555';
        ctx.fillRect(0, ground, W, 2);

        // Dino body
        ctx.fillStyle = '#333';
        ctx.fillRect(dino.x, dino.y, dino.w, dino.h);
        // Dino eye
        ctx.fillStyle = '#fff';
        ctx.fillRect(dino.x + 20, dino.y + 6, 6, 6);
        ctx.fillStyle = '#333';
        ctx.fillRect(dino.x + 23, dino.y + 8, 3, 3);
        // Dino legs
        if (frameCount % 10 < 5) {
            ctx.fillRect(dino.x + 5, dino.y + dino.h, 6, 8);
            ctx.fillRect(dino.x + 18, dino.y + dino.h, 6, 8);
        } else {
            ctx.fillRect(dino.x + 8, dino.y + dino.h, 6, 8);
            ctx.fillRect(dino.x + 15, dino.y + dino.h, 6, 8);
        }

        // Physics
        dino.vy += 0.6; // gravity
        dino.y += dino.vy;
        if (dino.y >= ground - dino.h) {
            dino.y = ground - dino.h;
            dino.vy = 0;
            dino.jumping = false;
        }

        // Obstacles
        obstacles.forEach(obs => {
            obs.x -= speed;

            // Draw cactus
            ctx.fillStyle = '#2d8a4e';
            ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
            // Cactus arms
            ctx.fillRect(obs.x - 5, obs.y + obs.h * 0.3, 5, 4);
            ctx.fillRect(obs.x + obs.w, obs.y + obs.h * 0.5, 5, 4);

            // Collision detection (with slight margin)
            if (
                dino.x + 4 < obs.x + obs.w &&
                dino.x + dino.w - 4 > obs.x &&
                dino.y + 4 < obs.y + obs.h &&
                dino.y + dino.h > obs.y
            ) {
                gameOver();
                return;
            }
        });

        // Remove offscreen and spawn new
        obstacles = obstacles.filter(o => o.x + o.w > 0);
        if (obstacles.length === 0 || obstacles[obstacles.length - 1].x < W - 200 - Math.random() * 200) {
            obstacles.push(spawnObstacle());
        }

        // Score
        frameCount++;
        if (frameCount % 6 === 0) {
            score++;
            document.getElementById('dino-score').textContent = score;
        }

        // Increase speed
        if (score % 50 === 0 && score > 0) speed = Math.min(10, 4 + score / 50);

        animId = requestAnimationFrame(loop);
    }

    function gameOver() {
        gameRunning = false;
        cancelAnimationFrame(animId);
        if (score > bestScore) {
            bestScore = score;
            document.getElementById('dino-best').textContent = bestScore;
        }
        const overlay = document.getElementById('dino-overlay');
        document.getElementById('dino-overlay-text').textContent = 'Game Over! Score: ' + score;
        overlay.classList.remove('hidden');
    }

    // Controls
    document.addEventListener('keydown', (e) => {
        if (e.code === 'Space' || e.key === 'ArrowUp') {
            e.preventDefault();
            if (!gameRunning && document.getElementById('dino-overlay').classList.contains('hidden') === false) {
                // ignore, let them click Play
            } else {
                jump();
            }
        }
    });

    // Touch control on canvas wrapper
    document.getElementById('dino-canvas-wrap').addEventListener('touchstart', (e) => {
        e.preventDefault();
        if (gameRunning) jump();
    });

    document.getElementById('dino-canvas-wrap').addEventListener('click', () => {
        if (gameRunning) jump();
    });

    window.dinoStart = start;

    window.addEventListener('game-closed', (e) => {
        if (e.detail.game === 'dino') {
            gameRunning = false;
            cancelAnimationFrame(animId);
        }
    });

    window.addEventListener('game-opened', (e) => {
        if (e.detail.game === 'dino') resize();
    });

    resize();
    window.addEventListener('resize', resize);
})();
</script>
