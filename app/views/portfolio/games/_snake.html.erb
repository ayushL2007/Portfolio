<style>
    .snake-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px;
        font-family: 'Segoe UI', sans-serif;
    }

    .snake-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: white;
        margin-bottom: 8px;
    }

    .snake-info {
        color: #aaa;
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .snake-info span { color: white; }

    .snake-canvas-wrap {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.15);
        box-shadow: 0 0 40px rgba(39, 174, 96, 0.1);
    }

    #snake-canvas {
        display: block;
        background: #111;
    }

    .snake-overlay {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.7);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        gap: 14px;
        transition: opacity 0.3s ease;
    }

    .snake-overlay.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .snake-overlay h2 {
        font-size: 1.5rem;
        font-weight: 800;
    }

    .snake-overlay p {
        color: #ccc;
        font-size: 0.9rem;
    }

    .snake-play-btn {
        padding: 12px 36px;
        border-radius: 50px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .snake-play-btn:hover {
        background: rgba(255,255,255,0.3);
    }

    .snake-controls {
        display: none;
        margin-top: 16px;
        gap: 6px;
    }

    .snake-ctrl-row {
        display: flex;
        justify-content: center;
        gap: 6px;
    }

    .snake-ctrl-btn {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        font-size: 1.3rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
        user-select: none;
        -webkit-user-select: none;
    }

    .snake-ctrl-btn:active {
        background: rgba(255,255,255,0.25);
    }

    .snake-ctrl-spacer {
        width: 56px;
        height: 56px;
    }

    @media (max-width: 768px) {
        .snake-controls {
            display: block;
        }
    }
</style>

<div class="snake-container">
    <div class="snake-title">Snake</div>
    <div class="snake-info">
        Score: <span id="snake-score">0</span> &nbsp;|&nbsp;
        Best: <span id="snake-best">0</span>
    </div>

    <div class="snake-canvas-wrap">
        <canvas id="snake-canvas" width="400" height="400"></canvas>
        <div class="snake-overlay" id="snake-overlay">
            <h2 id="snake-overlay-text">Snake</h2>
            <p>Arrow keys or swipe to move</p>
            <button class="snake-play-btn" onclick="snakeStart()">Play</button>
        </div>
    </div>

    <!-- Mobile D-pad controls -->
    <div class="snake-controls" id="snake-controls">
        <div class="snake-ctrl-row">
            <div class="snake-ctrl-spacer"></div>
            <button class="snake-ctrl-btn" onclick="snakeSetDir(0,-1)"><i class="fa-solid fa-arrow-up"></i></button>
            <div class="snake-ctrl-spacer"></div>
        </div>
        <div class="snake-ctrl-row">
            <button class="snake-ctrl-btn" onclick="snakeSetDir(-1,0)"><i class="fa-solid fa-arrow-left"></i></button>
            <button class="snake-ctrl-btn" onclick="snakeSetDir(0,1)"><i class="fa-solid fa-arrow-down"></i></button>
            <button class="snake-ctrl-btn" onclick="snakeSetDir(1,0)"><i class="fa-solid fa-arrow-right"></i></button>
        </div>
    </div>
</div>

<script>
(function() {
    const canvas = document.getElementById('snake-canvas');
    const ctx = canvas.getContext('2d');
    const GRID = 20;
    const COLS = canvas.width / GRID;
    const ROWS = canvas.height / GRID;

    let snake, dir, nextDir, food, score, bestScore = 0, gameRunning, interval;

    function spawnFood() {
        let pos;
        do {
            pos = {
                x: Math.floor(Math.random() * COLS),
                y: Math.floor(Math.random() * ROWS)
            };
        } while (snake.some(s => s.x === pos.x && s.y === pos.y));
        return pos;
    }

    function start() {
        snake = [{ x: Math.floor(COLS / 2), y: Math.floor(ROWS / 2) }];
        dir = { x: 1, y: 0 };
        nextDir = { x: 1, y: 0 };
        score = 0;
        document.getElementById('snake-score').textContent = 0;
        food = spawnFood();
        gameRunning = true;
        document.getElementById('snake-overlay').classList.add('hidden');
        clearInterval(interval);
        interval = setInterval(tick, 120);
    }

    function tick() {
        if (!gameRunning) return;

        dir = { ...nextDir };
        const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

        // Wall collision
        if (head.x < 0 || head.x >= COLS || head.y < 0 || head.y >= ROWS) {
            return gameOver();
        }

        // Self collision
        if (snake.some(s => s.x === head.x && s.y === head.y)) {
            return gameOver();
        }

        snake.unshift(head);

        // Eat food
        if (head.x === food.x && head.y === food.y) {
            score++;
            document.getElementById('snake-score').textContent = score;
            food = spawnFood();
        } else {
            snake.pop();
        }

        draw();
    }

    function draw() {
        ctx.fillStyle = '#111';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Grid lines
        ctx.strokeStyle = 'rgba(255,255,255,0.03)';
        for (let x = 0; x < COLS; x++) {
            for (let y = 0; y < ROWS; y++) {
                ctx.strokeRect(x * GRID, y * GRID, GRID, GRID);
            }
        }

        // Food
        ctx.fillStyle = '#e74c3c';
        ctx.beginPath();
        ctx.arc(food.x * GRID + GRID / 2, food.y * GRID + GRID / 2, GRID / 2 - 2, 0, Math.PI * 2);
        ctx.fill();

        // Snake
        snake.forEach((seg, i) => {
            const brightness = 1 - (i / snake.length) * 0.5;
            ctx.fillStyle = `rgba(46, 204, 113, ${brightness})`;
            ctx.fillRect(seg.x * GRID + 1, seg.y * GRID + 1, GRID - 2, GRID - 2);
            if (i === 0) {
                // Head highlight
                ctx.fillStyle = 'rgba(255,255,255,0.2)';
                ctx.fillRect(seg.x * GRID + 1, seg.y * GRID + 1, GRID - 2, 4);
            }
        });
    }

    function gameOver() {
        gameRunning = false;
        clearInterval(interval);
        if (score > bestScore) {
            bestScore = score;
            document.getElementById('snake-best').textContent = bestScore;
        }
        document.getElementById('snake-overlay-text').textContent = 'Game Over! Score: ' + score;
        document.getElementById('snake-overlay').classList.remove('hidden');
    }

    function setDirection(dx, dy) {
        // Prevent 180-degree turns
        if (dir.x === -dx && dir.y === -dy) return;
        if (dx !== 0 || dy !== 0) {
            nextDir = { x: dx, y: dy };
        }
    }

    // Keyboard
    document.addEventListener('keydown', (e) => {
        if (!gameRunning) return;
        switch (e.key) {
            case 'ArrowUp':    e.preventDefault(); setDirection(0, -1); break;
            case 'ArrowDown':  e.preventDefault(); setDirection(0, 1); break;
            case 'ArrowLeft':  e.preventDefault(); setDirection(-1, 0); break;
            case 'ArrowRight': e.preventDefault(); setDirection(1, 0); break;
        }
    });

    // Touch swipe detection
    let touchStartX, touchStartY;
    canvas.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
    });

    canvas.addEventListener('touchend', (e) => {
        if (!gameRunning) return;
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > Math.abs(dy)) {
            setDirection(dx > 0 ? 1 : -1, 0);
        } else {
            setDirection(0, dy > 0 ? 1 : -1);
        }
    });

    window.snakeStart = start;
    window.snakeSetDir = setDirection;

    window.addEventListener('game-closed', (e) => {
        if (e.detail.game === 'snake') {
            gameRunning = false;
            clearInterval(interval);
        }
    });

    // Initial draw
    ctx.fillStyle = '#111';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
})();
</script>
