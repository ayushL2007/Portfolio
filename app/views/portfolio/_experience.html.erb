<style>
    /* --- SHARED BASE STYLE (CLAYMORPHISM) --- */
    .timeline-section {
        max-width: 900px;
        margin: 80px auto;
        padding: 0 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .section-title {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 60px;
        color: #2d2248;
        text-shadow: 1px 1px 0 rgba(255,255,255,0.5);
    }

    .timeline {
        position: relative;
        border-left: 4px solid #ddd8e8;
        margin-left: 30px;
        padding-left: 40px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 50px;
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: opacity, transform;
    }

    /* --- CLAY DOT --- */
    .timeline-dot {
        position: absolute;
        left: -53px;
        top: 5px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: none;
        background: #7c3aed;
        box-shadow:
            4px 4px 10px rgba(124, 58, 237, 0.25),
            -3px -3px 8px rgba(255, 255, 255, 0.5),
            inset 2px 2px 4px rgba(255, 255, 255, 0.4),
            inset -1px -1px 3px rgba(80, 20, 180, 0.25);
    }

    .timeline-date {
        font-weight: bold;
        margin-bottom: 10px;
        color: #7c3aed;
    }

    /* --- CLAY CONTENT CARD --- */
    .timeline-content {
        background: #e8e4f0;
        padding: 24px;
        border-radius: 22px;
        border: none;
        color: #4a4060;
        box-shadow:
            8px 8px 16px rgba(0, 0, 0, 0.08),
            -6px -6px 14px rgba(255, 255, 255, 0.55),
            inset 2px 2px 5px rgba(255, 255, 255, 0.5),
            inset -2px -2px 4px rgba(0, 0, 0, 0.04);
        transition: all 0.3s ease;
    }

    .timeline-content:hover {
        box-shadow:
            10px 10px 20px rgba(0, 0, 0, 0.1),
            -8px -8px 18px rgba(255, 255, 255, 0.65),
            inset 3px 3px 6px rgba(255, 255, 255, 0.6),
            inset -2px -2px 5px rgba(0, 0, 0, 0.06);
    }

    .timeline-content h3 { margin: 0; font-size: 1.5rem; color: #2d2248; }
    .timeline-content h4 { margin: 5px 0; color: #6b5f80; font-weight: 500; }
    
    .timeline-content ul { margin: 10px 0 0 20px; padding: 0; }
    .timeline-content li { margin-bottom: 5px; color: #4a4060; }

    /* --- EDUCATION CLAY DOT (MAROON) --- */
    #education .timeline { border-left-color: #ddd8e8; }
    #education .timeline-dot {
        background: #c44040;
        box-shadow:
            4px 4px 10px rgba(180, 50, 50, 0.25),
            -3px -3px 8px rgba(255, 255, 255, 0.5),
            inset 2px 2px 4px rgba(255, 180, 180, 0.35),
            inset -1px -1px 3px rgba(140, 30, 30, 0.2);
    }

    #education .timeline-date {
        color: #c44040;
    }

    /* Animation State */
    .timeline-item.revealed {
        opacity: 1 !important;
        transform: translateY(0) !important;
    }

    /* --- MOBILE RESPONSIVE --- */
    @media (max-width: 768px) {
        .timeline-section {
            margin: 40px auto;
            padding: 0 15px;
        }

        .section-title {
            font-size: 1.8rem;
            margin-bottom: 35px;
        }

        .timeline {
            margin-left: 15px;
            padding-left: 20px;
        }

        .timeline-dot {
            left: -33px;
            width: 18px;
            height: 18px;
        }

        .timeline-item {
            margin-bottom: 35px;
        }

        .timeline-content {
            padding: 18px;
        }

        .timeline-content h3 {
            font-size: 1.2rem;
        }

        .timeline-content h4 {
            font-size: 0.95rem;
        }

        .timeline-date {
            font-size: 0.9rem;
        }
    }
</style>

<section class="timeline-section" id="experience">
